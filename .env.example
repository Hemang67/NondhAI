# Copy this file to .env.local (git-ignored) and fill in the values.
# They are built into the app by `npm run dist` / `npm run release`.

# Google Cloud Console → Google Auth Platform → Clients → your "Desktop app" client.
# With these set, users just click "Connect Google"; the ID fields move under Advanced.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
