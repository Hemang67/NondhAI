{
  "name": "nondh",
  "productName": "Nondh AI",
  "version": "0.4.0",
  "description": "Offline-first dictation and meeting transcription for Windows",
  "main": "out/main/index.js",
  "private": true,
  "license": "MIT",
  "author": "Hemang Rathod",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:native": "node scripts/build-native.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build:native && electron-vite build && electron-builder --win --x64 --publish never",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.17",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "marked": "^18.0.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "docx": "^9.14.0",
    "electron-updater": "^6.8.10",
    "ffmpeg-static": "^5.3.0",
    "sherpa-onnx-node": "^1.13.8",
    "zod": "^4.6.7"
  }
}
